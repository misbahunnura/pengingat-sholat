APP_NAME="Pengingat Salat"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Metode hitung Aladhan: 20 = Kemenag RI
SALAT_METODE=20

# Database SQLite (file database/database.sqlite), tidak perlu MySQL
DB_CONNECTION=sqlite

# Akun admin pertama (dibuat oleh: php artisan migrate --seed)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@pengingat.test
ADMIN_PASSWORD=ganti-password-ini

# Kunci push notification (isi otomatis: php artisan salat:vapid --simpan)
VAPID_SUBJECT=mailto:admin@pengingat.test
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
